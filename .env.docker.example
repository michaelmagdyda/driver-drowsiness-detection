# =============================================================================
# Docker Compose variables - TEMPLATE
# =============================================================================
# Copy to `.env` in this same directory:
#
#   copy .env.docker.example .env        (Windows)
#   cp   .env.docker.example .env        (macOS / Linux)
#
# Docker Compose reads `.env` automatically. This file supplies only the
# values compose itself needs to interpolate - chiefly the frontend's
# build-time configuration and the host port mappings.
#
# -----------------------------------------------------------------------------
# WHERE THE BACKEND'S SECRETS COME FROM - they are NOT here
# -----------------------------------------------------------------------------
# SECRET_KEY, SUPABASE_SERVICE_ROLE_KEY, SMTP_PASSWORD and WHATSAPP_API_KEY are
# read from `Backend/.env` through the `env_file:` entry in docker-compose.yml.
# That keeps exactly one copy of every credential, in a file that is already
# gitignored and is excluded from the image by Backend/.dockerignore.
#
# Do not duplicate those values into this file. Nothing here is baked into an
# image at build time except the VITE_* values below, which are public.
# =============================================================================


# -----------------------------------------------------------------------------
# FRONTEND - build-time configuration  (REQUIRED)
# -----------------------------------------------------------------------------
# Vite inlines every VITE_* value into the JavaScript bundle it emits, so these
# are compiled in at `docker compose build` and cannot be changed at run time.
# Rebuild the frontend image to change them.
#
# All three are PUBLIC by design - the publishable/anon Supabase key is meant
# to be visible in the browser and is protected by Row Level Security. The
# service-role key is a different value entirely and must NEVER appear here.
#
# Copy these from Frontend/.env.

# Where the BROWSER reaches the API. This is resolved on the host by the user's
# browser, so it is a host URL. `http://backend:8000` is the compose service
# name: correct for container-to-container calls, broken for the browser.
VITE_API_URL=http://localhost:8000/api/v1

# Supabase project URL, e.g. https://<project-id>.supabase.co
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Publishable / anon key (the browser-safe one, NOT service_role).
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key-here

# Optional - used for display only.
VITE_SUPABASE_PROJECT_ID=your-project-id


# -----------------------------------------------------------------------------
# HOST PORT MAPPINGS  (optional - sensible defaults in docker-compose.yml)
# -----------------------------------------------------------------------------
# Change only if something already occupies these ports on your machine. If you
# change BACKEND_PORT you must also update VITE_API_URL above and the backend's
# ALLOWED_ORIGINS in docker-compose.yml to match, or CORS will reject the app.
BACKEND_PORT=8000
FRONTEND_PORT=3000
