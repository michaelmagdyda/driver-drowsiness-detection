# =============================================================================
# Driver Drowsiness Detection System - Backend Environment
# =============================================================================
# Copy this file to `.env` and fill in the real values:
#
#   copy .env.example .env
#
# `.env` is gitignored and must NEVER be committed (Coding Standards §14).
# In production these are supplied as hosting-provider secrets, not as a file
# (Deployment Architecture §8).
#
# Each variable is tagged with the phase that starts using it. Phase D reads
# only the APPLICATION and SECURITY sections; the rest are declared now so the
# contract is visible up front and nothing has to be restructured later.
# =============================================================================


# -----------------------------------------------------------------------------
# APPLICATION                                                       [Phase D]
# -----------------------------------------------------------------------------
# Environment name. Enables the stricter startup checks (an explicit, non-
# wildcard CORS allowlist is mandatory when set to production).
# Swagger stays available in every environment - Deployment §15 publishes it at
# /docs and §24 lists "Swagger Available" on the production checklist.
# One of: development | staging | production
APP_ENV=development

# Python logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Server bind address. 127.0.0.1 for local dev; 0.0.0.0 inside a container.
HOST=127.0.0.1
PORT=8000

# REST base path. The frontend and API Specification §2 both assume /api/v1.
# Changing this breaks every documented endpoint - do not alter casually.
API_V1_PREFIX=/api/v1


# -----------------------------------------------------------------------------
# SECURITY                                                          [Phase D/E]
# -----------------------------------------------------------------------------
# Comma-separated CORS allowlist. Add the Lovable preview/production origin
# before connecting the frontend in Phase I. No wildcards in production.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Application-level signing secret for anything the backend issues itself.
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-a-random-48-byte-urlsafe-string


# -----------------------------------------------------------------------------
# SUPABASE                                                          [Phase E/F]
# -----------------------------------------------------------------------------
# Project URL. Not a secret - it is already public in the frontend bundle.
# A trailing slash is stripped automatically: the expected token issuer is built
# by appending /auth/v1, and a double slash would reject every token.
SUPABASE_URL=https://lejbnpdeudtxvsgsickd.supabase.co

# Service-role key. FULL DATABASE ACCESS, BYPASSES ROW LEVEL SECURITY.
# Backend only. Never ship this to the browser (Frontend Integration §11).
# Because it bypasses RLS, the service layer must filter by the authenticated
# user on every query - RLS is the second line of defence here, not the first.
# Supabase dashboard -> Project Settings -> API -> service_role (or the new
# `sb_secret_...` secret key). This file is a COMMITTED template: never paste a
# real key here. Put the real value in .env, which is gitignored.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# SUPABASE_JWT_SECRET is intentionally NOT listed as a variable. This project
# uses Supabase's asymmetric signing keys (ES256/P-256): tokens are verified
# against PUBLIC keys fetched from the JWKS endpoint (<url>/auth/v1/.well-known/
# jwks.json), so no shared secret exists or is needed. If an old value lingers
# in your .env it is ignored, and you may delete it.

# -----------------------------------------------------------------------------
# AUTHENTICATION                                                      [Phase E]
# -----------------------------------------------------------------------------
# Token verification needs no secret. The backend derives the JWKS endpoint from
# SUPABASE_URL (<url>/auth/v1/.well-known/jwks.json), fetches the public keys
# once, caches them, and verifies every token locally against the cache.
#
# The signing algorithm is intentionally absent from this file. It is pinned to
# ES256 in code, because an environment-configurable algorithm can be weakened
# to "none" or downgraded to an HMAC scheme whose "secret" is the public key -
# both well-known JWT forgery routes.

# Expected `aud` claim on a Supabase user access token. Change only if Supabase
# changes what it mints.
JWT_AUDIENCE=authenticated

# Clock-skew tolerance in seconds when checking token expiry. Guards against
# small drift between this host and Supabase. Range 0-300.
JWT_LEEWAY_SECONDS=60

# Seconds a fetched JWKS key set is treated as fresh. Long is fine: public keys
# rotate rarely, and a token with an unrecognised key id triggers an immediate
# refresh regardless. Range 60-86400.
JWT_JWKS_CACHE_TTL=600

# Minimum seconds between JWKS refetches. Rate-limits the refresh-on-unknown-key
# path so bogus key ids cannot flood the JWKS endpoint. Range 0-3600.
JWT_JWKS_MIN_REFRESH_INTERVAL=30

# Seconds to cache a user's role lookup (decision E-D3). Roles are read from
# public.user_roles, so 0 means a database round-trip per authorised request.
# A demoted administrator retains access for at most this long; set 0 for
# immediate revocation at the cost of latency. Range 0-3600.
AUTH_ROLE_CACHE_TTL=60


# -----------------------------------------------------------------------------
# AI MODEL                                                          [Phase G]
# -----------------------------------------------------------------------------
# Path to the trained Faster R-CNN checkpoint, relative to this Backend folder.
# Per decision C3 the 128 MB weights are NOT copied here - this points at the
# existing checkpoint at the repository root. The architecture documents refer
# to a YOLO "best.pt"; the real artefact is a from-scratch Faster R-CNN ".pth".
MODEL_PATH=../../checkpoints/tuned/best.pth

# Inference device: cuda:0 | cpu | auto
# "auto" selects CUDA when available and falls back to CPU (§25 requires the
# CPU fallback). Note: CUDA is currently unavailable on this machine, so live
# monitoring will run at a few FPS until that is resolved.
MODEL_DEVICE=auto

# Minimum detection confidence. Mirrors SCORE_THRESH in the root config.py.
MODEL_SCORE_THRESHOLD=0.5


# -----------------------------------------------------------------------------
# UPLOAD LIMITS                                                     [Phase G]
# -----------------------------------------------------------------------------
# Backend performs the final validation; the frontend pre-checks only
# (Frontend Integration §8).
MAX_IMAGE_SIZE_MB=25
MAX_VIDEO_SIZE_MB=500


# -----------------------------------------------------------------------------
# EMAIL NOTIFICATIONS                                               [Phase J]
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password-here
SMTP_FROM_NAME=DriveAlert


# -----------------------------------------------------------------------------
# WHATSAPP NOTIFICATIONS                                            [Phase J]
# -----------------------------------------------------------------------------
WHATSAPP_API_KEY=your-whatsapp-api-key-here
